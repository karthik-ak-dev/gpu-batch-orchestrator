{
    "Comment": "Parallel jobs (job1, job2) -> job3 -> job4 using S3 for data transfer",
    "StartAt": "ParallelJobs",
    "States": {
        "ParallelJobs": {
            "Type": "Parallel",
            "Branches": [
                {
                    "StartAt": "Job1",
                    "States": {
                        "Job1": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::batch:submitJob.sync",
                            "Parameters": {
                                "JobName": "job1",
                                "JobQueue": "arn:aws:batch:us-east-2:508153278741:job-queue/gpu-batch-queue",
                                "JobDefinition": "arn:aws:batch:us-east-2:508153278741:job-definition/gpu-batch-job1:4",
                                "ContainerOverrides": {
                                    "Environment": [
                                        {
                                            "Name": "EXECUTION_ID",
                                            "Value.$": "$$.Execution.Name"
                                        },
                                        {
                                            "Name": "S3_BUCKET",
                                            "Value": "gpu-batch-orchestrator-results-qwerty"
                                        },
                                        {
                                            "Name": "JOB_NAME",
                                            "Value": "job1"
                                        },
                                        {
                                            "Name": "INPUT_DATA",
                                            "Value.$": "States.JsonToString($)"
                                        }
                                    ]
                                }
                            },
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "Job2",
                    "States": {
                        "Job2": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::batch:submitJob.sync",
                            "Parameters": {
                                "JobName": "job2",
                                "JobQueue": "arn:aws:batch:us-east-2:508153278741:job-queue/gpu-batch-queue",
                                "JobDefinition": "arn:aws:batch:us-east-2:508153278741:job-definition/gpu-batch-job2:4",
                                "ContainerOverrides": {
                                    "Environment": [
                                        {
                                            "Name": "EXECUTION_ID",
                                            "Value.$": "$$.Execution.Name"
                                        },
                                        {
                                            "Name": "S3_BUCKET",
                                            "Value": "gpu-batch-orchestrator-results-qwerty"
                                        },
                                        {
                                            "Name": "JOB_NAME",
                                            "Value": "job2"
                                        },
                                        {
                                            "Name": "INPUT_DATA",
                                            "Value.$": "States.JsonToString($)"
                                        }
                                    ]
                                }
                            },
                            "End": true
                        }
                    }
                }
            ],
            "Next": "Job3"
        },
        "Job3": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
                "JobName": "job3",
                "JobQueue": "arn:aws:batch:us-east-2:508153278741:job-queue/gpu-batch-queue",
                "JobDefinition": "arn:aws:batch:us-east-2:508153278741:job-definition/gpu-batch-job3:4",
                "ContainerOverrides": {
                    "Environment": [
                        {
                            "Name": "EXECUTION_ID",
                            "Value.$": "$$.Execution.Name"
                        },
                        {
                            "Name": "S3_BUCKET",
                            "Value": "gpu-batch-orchestrator-results-qwerty"
                        },
                        {
                            "Name": "JOB_NAME",
                            "Value": "job3"
                        }
                    ]
                }
            },
            "Next": "Job4"
        },
        "Job4": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
                "JobName": "job4",
                "JobQueue": "arn:aws:batch:us-east-2:508153278741:job-queue/gpu-batch-queue",
                "JobDefinition": "arn:aws:batch:us-east-2:508153278741:job-definition/gpu-batch-job4:4",
                "ContainerOverrides": {
                    "Environment": [
                        {
                            "Name": "EXECUTION_ID",
                            "Value.$": "$$.Execution.Name"
                        },
                        {
                            "Name": "S3_BUCKET",
                            "Value": "gpu-batch-orchestrator-results-qwerty"
                        },
                        {
                            "Name": "JOB_NAME",
                            "Value": "job4"
                        }
                    ]
                }
            },
            "End": true
        }
    }
}