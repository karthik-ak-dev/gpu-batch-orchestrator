{
    "Comment": "Sequential batch jobs (job1 -> job2 -> job3) using S3 for data transfer between stages",
    "StartAt": "PrepareEnvironment",
    "States": {
        "PrepareEnvironment": {
            "Type": "Pass",
            "Parameters": {
                "common_env": [
                    {
                        "Name": "JOB_ID",
                        "Value.$": "$.job_id"
                    },
                    {
                        "Name": "S3_BUCKET",
                        "Value": "my-results-bucket"
                    },
                    {
                        "Name": "INPUT_DATA",
                        "Value.$": "States.JsonToString($)"
                    }
                ],
                "job_id.$": "$.job_id"
            },
            "Next": "Job1_Ingestion"
        },
        "Job1_Ingestion": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
                "JobName": "job1_ingestion",
                "JobQueue": "arn:aws:batch:us-east-1:123456789012:job-queue/gpu-batch-queue",
                "JobDefinition": "arn:aws:batch:us-east-1:123456789012:job-definition/gpu-batch-job1:1",
                "ContainerOverrides": {
                    "Environment.$": "$.common_env"
                }
            },
            "ResultPath": "$.job1_result",
            "Next": "Job2_Transform"
        },
        "Job2_Transform": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
                "JobName": "job2_transform",
                "JobQueue": "arn:aws:batch:us-east-1:123456789012:job-queue/gpu-batch-queue",
                "JobDefinition": "arn:aws:batch:us-east-1:123456789012:job-definition/gpu-batch-job2:1",
                "ContainerOverrides": {
                    "Environment.$": "$.common_env"
                }
            },
            "ResultPath": "$.job2_result",
            "Next": "Job3_Aggregate"
        },
        "Job3_Aggregate": {
            "Type": "Task",
            "Resource": "arn:aws:states:::batch:submitJob.sync",
            "Parameters": {
                "JobName": "job3_aggregate",
                "JobQueue": "arn:aws:batch:us-east-1:123456789012:job-queue/gpu-batch-queue",
                "JobDefinition": "arn:aws:batch:us-east-1:123456789012:job-definition/gpu-batch-job3:1",
                "ContainerOverrides": {
                    "Environment.$": "$.common_env"
                }
            },
            "ResultPath": "$.job3_result",
            "End": true
        }
    }
}
